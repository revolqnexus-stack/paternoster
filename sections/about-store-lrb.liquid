{% comment %}
  LRB Store - About Section
  Matches "About the LRB Store" section from homepage reference
{% endcomment %}

<section class="lrb-section lrb-about-store">
  <div class="lrb-container lrb-container--narrow">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="lrb-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    <div class="lrb-about-store__content">
      {%- if section.settings.text != blank -%}
        {{ section.settings.text }}
      {%- endif -%}
    </div>
    
  </div>
</section>

<style>
.lrb-about-store {
  background: var(--lrb-color-background);
  padding: var(--lrb-space-xl) 0;
}

.lrb-about-store__content {
  font-family: var(--lrb-font-body);
  font-size: var(--lrb-font-size-base);
  line-height: var(--lrb-line-height-relaxed);
  color: var(--lrb-color-text-muted);
}

.lrb-about-store__content p {
  margin: 0 0 var(--lrb-space-md) 0;
}

.lrb-about-store__content p:last-child {
  margin-bottom: 0;
}

.lrb-about-store__content a {
  color: var(--lrb-color-text);
  text-decoration: underline;
  text-decoration-color: var(--lrb-color-border);
  text-underline-offset: 0.2em;
  transition: text-decoration-color var(--lrb-transition-fast);
}

.lrb-about-store__content a:hover {
  text-decoration-color: var(--lrb-color-text);
}

@media (max-width: 767px) {
  .lrb-about-store {
    padding: var(--lrb-space-lg) 0;
  }
}
</style>

{% schema %}
{
  "name": "About the Store",
  "tag": "section",
  "class": "section-about-store",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About the LRB Store"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add information about your store, its history, mission, and unique offerings.</p><p>This section should tell your story and connect with customers.</p>"
    }
  ],
  "presets": [
    {
      "name": "About the Store"
    }
  ]
}
{% endschema %}
