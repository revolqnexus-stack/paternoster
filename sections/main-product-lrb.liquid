{% comment %}
  LRB Store Product Page
  Matches lrbstore.co.uk product detail layout
{% endcomment %}

{{ 'lrb-components.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="lrb-product-detail">
  <div class="lrb-container">
    <div class="lrb-product-detail__grid">
      
      {%- comment -%} Product Images {%- endcomment -%}
      <div class="lrb-product-detail__media">
        {%- if product.media.size > 0 -%}
          <div class="lrb-product-detail__main-image">
            <img
              src="{{ product.featured_media | image_url: width: 1000 }}"
              alt="{{ product.featured_media.alt | escape }}"
              class="lrb-product-detail__image"
              id="MainProductImage"
              loading="eager"
            >
          </div>
          
          {%- if product.media.size > 1 -%}
            <div class="lrb-product-detail__thumbnails">
              {%- for media in product.media limit: 6 -%}
                <button
                  type="button"
                  class="lrb-product-detail__thumbnail{% if forloop.first %} lrb-product-detail__thumbnail--active{% endif %}"
                  data-media-id="{{ media.id }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ media | image_url: width: 150 }}"
                    alt="{{ media.alt | escape }}"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
      
      {%- comment -%} Product Info {%- endcomment -%}
      <div class="lrb-product-detail__info">
        <h1 class="lrb-product-detail__title lrb-heading-lg">{{ product.title }}</h1>
        
        {%- comment -%} Price {%- endcomment -%}
        <div class="lrb-product-detail__price">
          {% render 'price-display-lrb',
            product: product,
            show_unit_price: true,
            size: 'large'
          %}
        </div>
        
        <p class="lrb-tax-notice">Taxes included.</p>
        
        {%- comment -%} Badges {%- endcomment -%}
        {%- if product.available == false or product.compare_at_price_max > product.price -%}
          <div class="lrb-product-detail__badges">
            {%- if product.compare_at_price_max > product.price -%}
              {% render 'badge-lrb', type: 'sale' %}
            {%- endif -%}
            {%- if product.available == false -%}
              {% render 'badge-lrb', type: 'sold-out' %}
            {%- endif -%}
          </div>
        {%- endif -%}
        
        {%- comment -%} Product Form {%- endcomment -%}
        {%- form 'product', product, id: product_form_id, class: 'lrb-product-detail__form' -%}
          
          {%- comment -%} Variant Selector {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="lrb-product-detail__variants">
              {%- for option in product.options_with_values -%}
                <div class="lrb-product-detail__option">
                  <label class="lrb-product-detail__option-label">
                    {{ option.name }}
                  </label>
                  <select
                    name="options[{{ option.name | escape }}]"
                    class="lrb-product-detail__option-select"
                  >
                    {%- for value in option.values -%}
                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}selected="selected"{% endif %}
                      >
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}
          
          {%- comment -%} Quantity {%- endcomment -%}
          <div class="lrb-product-detail__quantity-wrapper">
            <div class="lrb-quantity-selector">
              <label class="lrb-quantity-selector__label" for="Quantity-{{ section.id }}">
                Quantity
              </label>
              <div class="lrb-quantity-selector__controls">
                <button type="button" class="lrb-quantity-selector__button" data-quantity-minus>−</button>
                <input
                  type="number"
                  id="Quantity-{{ section.id }}"
                  name="quantity"
                  class="lrb-quantity-selector__input"
                  value="1"
                  min="1"
                  aria-label="Quantity"
                >
                <button type="button" class="lrb-quantity-selector__button" data-quantity-plus>+</button>
              </div>
              <span class="lrb-quantity-selector__cart-indicator">(0 in cart)</span>
            </div>
          </div>
          
          {%- comment -%} Add to Cart {%- endcomment -%}
          <div class="lrb-product-detail__actions">
            <button
              type="submit"
              name="add"
              class="lrb-button lrb-button--primary lrb-product-detail__add-button"
              {% if product.available == false %}disabled{% endif %}
            >
              {%- if product.available -%}
                Add to cart
              {%- else -%}
                Sold out
              {%- endif -%}
            </button>
          </div>
          
        {%- endform -%}
        
        {%- comment -%} Product Description {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="lrb-product-detail__description">
            {{ product.description }}
          </div>
        {%- endif -%}
        
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Thumbnail switching
  const thumbnails = document.querySelectorAll('.lrb-product-detail__thumbnail');
  const mainImage = document.getElementById('MainProductImage');
  
  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', function() {
      const mediaId = this.dataset.mediaId;
      // Remove active class from all thumbnails
      thumbnails.forEach(t => t.classList.remove('lrb-product-detail__thumbnail--active'));
      // Add active class to clicked thumbnail
      this.classList.add('lrb-product-detail__thumbnail--active');
      
      // Update main image (simplified - would need full media data in production)
      const newSrc = this.querySelector('img').src.replace('_150x', '_1000x');
      if (mainImage) {
        mainImage.src = newSrc;
      }
    });
  });
  
  // Quantity controls
  const quantityInput = document.querySelector('.lrb-quantity-selector__input');
  const minusBtn = document.querySelector('[data-quantity-minus]');
  const plusBtn = document.querySelector('[data-quantity-plus]');
  
  if (minusBtn && quantityInput) {
    minusBtn.addEventListener('click', function() {
      const currentValue = parseInt(quantityInput.value) || 1;
      if (currentValue > 1) {
        quantityInput.value = currentValue - 1;
      }
    });
  }
  
  if (plusBtn && quantityInput) {
    plusBtn.addEventListener('click', function() {
      const currentValue = parseInt(quantityInput.value) || 1;
      quantityInput.value = currentValue + 1;
    });
  }
});
</script>

<style>
.lrb-product-detail {
  padding: var(--lrb-space-xl) 0;
}

.lrb-product-detail__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--lrb-space-xl);
}

@media (min-width: 1024px) {
  .lrb-product-detail__grid {
    grid-template-columns: 1fr 1fr;
  }
}

.lrb-product-detail__main-image {
  background: var(--lrb-color-background-alt);
  margin-bottom: var(--lrb-space-sm);
}

.lrb-product-detail__image {
  width: 100%;
  height: auto;
  display: block;
}

.lrb-product-detail__thumbnails {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: var(--lrb-space-xs);
}

.lrb-product-detail__thumbnail {
  aspect-ratio: 1;
  border: 2px solid transparent;
  background: none;
  padding: 0;
  cursor: pointer;
  transition: border-color var(--lrb-transition-fast);
  overflow: hidden;
}

.lrb-product-detail__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lrb-product-detail__thumbnail:hover,
.lrb-product-detail__thumbnail--active {
  border-color: var(--lrb-color-text);
}

.lrb-product-detail__title {
  margin: 0 0 var(--lrb-space-sm) 0;
}

.lrb-product-detail__price {
  margin-bottom: var(--lrb-space-sm);
}

.lrb-product-detail__badges {
  display: flex;
  gap: var(--lrb-space-xs);
  margin: var(--lrb-space-sm) 0;
}

.lrb-product-detail__form {
  margin-top: var(--lrb-space-md);
}

.lrb-product-detail__variants {
  margin-bottom: var(--lrb-space-md);
}

.lrb-product-detail__option {
  margin-bottom: var(--lrb-space-sm);
}

.lrb-product-detail__option-label {
  display: block;
  font-family: var(--lrb-font-body);
  font-size: var(--lrb-font-size-sm);
  font-weight: var(--lrb-font-weight-medium);
  margin-bottom: 0.5rem;
}

.lrb-product-detail__option-select {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid var(--lrb-color-border-dark);
  border-radius: var(--lrb-radius-sm);
  font-family: var(--lrb-font-body);
  font-size: var(--lrb-font-size-base);
}

.lrb-product-detail__quantity-wrapper {
  margin-bottom: var(--lrb-space-md);
}

.lrb-product-detail__add-button {
  width: 100%;
  padding: 1rem 2rem;
  font-size: var(--lrb-font-size-base);
}

.lrb-product-detail__description {
  margin-top: var(--lrb-space-lg);
  padding-top: var(--lrb-space-lg);
  border-top: 1px solid var(--lrb-color-border);
  font-family: var(--lrb-font-body);
  font-size: var(--lrb-font-size-base);
  line-height: var(--lrb-line-height-relaxed);
  color: var(--lrb-color-text-muted);
}

.lrb-product-detail__description p {
  margin: 0 0 var(--lrb-space-sm) 0;
}
</style>

{% schema %}
{
  "name": "Product LRB",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    }
  ]
}
{% endschema %}
